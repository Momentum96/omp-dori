#!/bin/sh
# A fake `ssh-keyscan` for the worker tests: prints the ed25519 host key of a destination the fake
# `ssh` knows (`ssh-data/hosts/<host>_<port>.pub`, in the `ssh` fake's data directory).
dir=$(cd "$(dirname "$0")" && pwd)/ssh-data
port=22
while [ $# -gt 0 ]; do
    case "$1" in
        -p) port=$2; shift 2 ;;
        -T|-t) shift 2 ;;
        --) shift; break ;;
        *) break ;;
    esac
done
host=$1
file="$dir/hosts/${host}_$port.pub"
[ -f "$file" ] || exit 1
if [ "$port" = 22 ]; then pin=$host; else pin="[$host]:$port"; fi
echo "# $host:$port SSH-2.0-OpenSSH_9.6"
printf '%s ssh-ed25519 %s\n' "$pin" "$(awk '{print $2}' "$file")"
